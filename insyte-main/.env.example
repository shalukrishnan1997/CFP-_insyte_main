# ================================================================
# INSYTE DMS — Environment Variables (template)
#
# Copy to .env and fill in real values. The same .env file is consumed by:
#   * docker compose up (local dev with full prod-parity stack)
#   * Coolify (mounts this shape into the container at runtime)
#
# Conventions:
#   # REQUIRED  — app refuses to start without it (production settings)
#   # OPTIONAL  — feature-gated; safe to omit
#   # DEFAULT   — has a sensible default; only set to override
# ================================================================

# ─── Django core ───
SECRET_KEY=change-me-to-a-long-random-string                 # REQUIRED
FIELD_ENCRYPTION_SALT=set-once-and-never-rotate              # REQUIRED — rotating breaks all encrypted DB fields
ALLOWED_HOSTS=localhost,127.0.0.1                            # REQUIRED — comma-separated
# DJANGO_SETTINGS_MODULE is set by docker-compose env: block; only override if running outside compose.
# DEFAULT TIME_ZONE=Europe/London
# DEFAULT ENVIRONMENT=production    (used as Sentry tag)
# DEFAULT LOG_LEVEL=INFO

# ─── Database (PostgreSQL) ───
POSTGRES_NAME=insyte_db                                      # REQUIRED
POSTGRES_USER=insyte_user                                    # REQUIRED
POSTGRES_PASSWORD=                                           # REQUIRED
POSTGRES_HOST=insyte-db                                      # REQUIRED — service name in dev compose, managed-DB hostname in prod
# DEFAULT POSTGRES_PORT=5432
# DEFAULT POSTGRES_ENGINE=django.db.backends.postgresql
# OPTIONAL POSTGRES_SSLMODE=require   (set for managed DB; leave empty for in-stack Postgres)
# OPTIONAL POSTGRES_SSLROOTCERT=/path/to/ca.crt
# OPTIONAL POSTGRES_CONNECT_TIMEOUT=10

# ─── Redis / Celery ───
REDIS_PASSWORD=                                              # REQUIRED — Redis container demands auth
# REDIS_HOST and REDIS_PORT are set by compose (insyte-redis:6379); override only when pointing at managed Redis.
# DEFAULT REDIS_CACHE_DB=1
# DEFAULT REDIS_SESSION_DB=2
# DEFAULT REDIS_CELERY_RESULT_DB=3
# DEFAULT REDIS_CELERY_BROKER_DB=0
# OPTIONAL DJANGO_REDIS_CACHE_URL=redis://:pwd@host:6379/1   (full-URL override)
# OPTIONAL DJANGO_REDIS_SESSION_URL=redis://:pwd@host:6379/2
# OPTIONAL CELERY_BROKER_URL=redis://:pwd@host:6379/0
# OPTIONAL CELERY_RESULT_BACKEND=redis://:pwd@host:6379/3

# ─── Cloudflare R2 storage (scans, generated letters, invoices) ───
R2_ACCOUNT_ID=                                               # OPTIONAL — required if using R2 for media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=
R2_CUSTOM_DOMAIN=
# OPTIONAL R2_S3_ENDPOINT_URL=    (override the auto-derived S3 endpoint)
# OPTIONAL SCAN_R2_INTAKE_PREFIX=ScanOutput/

# ─── Document AI / scanner webhook ───
GOOGLE_CLOUD_PROJECT_ID=                                     # OPTIONAL — required for OCR
# Provide ONE of these (B64 preferred for Coolify):
GOOGLE_APPLICATION_CREDENTIALS_JSON_B64=
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-service-account.json
SCAN_WEBHOOK_SECRET=                                         # REQUIRED if scanner workstation posts uploads
# OPTIONAL OCR_AUTO_PROCESS_ON_UPLOAD=true
# OPTIONAL MAX_OCR_PAGES_PER_PDF=100
# OPTIONAL SCAN_BATCH_MAX_SIZE=30
# OPTIONAL DOCUMENT_AI_MAX_RETRY_ATTEMPTS=5
# OPTIONAL DOCUMENT_AI_CLIENT_CACHE_TTL_SECONDS=3600
# Hardening:
# OPTIONAL INSYTE_SCAN_WEBHOOK_TIMESTAMP_REQUIRED=true
# OPTIONAL INSYTE_STRICT_SCANNER_STATUS_VALIDATION=true

# ─── Stripe payments ───
# Stripe credentials live per-client in PaymentGatewayConfig (DB-backed,
# encrypted via FIELD_ENCRYPTION_SALT). No global STRIPE_* env vars are read
# by the application — seed PaymentGatewayConfig rows instead.
# PCI-tightening (defaults are safe-off in production):
# OPTIONAL STORE_STRIPE_RAW_PAYLOADS=false
# OPTIONAL ALLOW_CARD_METADATA_EXPORT=false
# OPTIONAL STRICT_UNREDACTED_SCAN_VIEW=false
# OPTIONAL REDACTION_MAX_SOURCE_BYTES=52428800
# OPTIONAL INSYTE_REDACTION_RETENTION_DAYS=7    # backstop TTL; see docs/pci-retention.md

# ─── Email — Resend primary, SMTP fallback ───
# DEFAULT EMAIL_BACKEND=core.mail_backends.ResendBackend
RESEND_API_KEY=                                              # REQUIRED if using Resend
DEFAULT_FROM_EMAIL=noreply@example.com                       # REQUIRED
SERVER_EMAIL=noreply@example.com                             # OPTIONAL — defaults to DEFAULT_FROM_EMAIL
# Only used if EMAIL_BACKEND is set to Django SMTP backend:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# ─── Security / TLS (production) ───
CSRF_TRUSTED_ORIGINS=https://yourdomain.com                  # REQUIRED for cross-origin POST
# DEFAULT CSRF_COOKIE_SECURE=true
# DEFAULT SESSION_COOKIE_SECURE=true
# DEFAULT SECURE_SSL_REDIRECT=true
# DEFAULT SECURE_HSTS_SECONDS=31536000                       # MUST be non-zero in prod (a local dev .env may set this to 0)

# Axes (login lockout) proxy-hop count. Number of trusted reverse proxies in
# front of this app. The reverse proxy MUST strip any client-supplied
# X-Forwarded-For header and set its own; otherwise an attacker can spoof
# their source IP to dodge the per-IP lockout. Default 1 matches a single
# Traefik/Coolify proxy.
# DEFAULT AXES_PROXY_COUNT=1

# ─── Observability ───
# OPTIONAL SENTRY_DSN=https://...@sentry.io/...
# /metrics is gated by client IP. INSYTE_METRICS_TRUSTED_PROXIES is the
# allowlist of reverse-proxy IPs whose X-Forwarded-For we will honour.
# The reverse proxy MUST strip any client-supplied X-Forwarded-For header
# before adding its own — otherwise an attacker can spoof their source IP
# and scrape internal metrics.
# OPTIONAL INSYTE_METRICS_ALLOWED_IPS=127.0.0.1,::1
# OPTIONAL INSYTE_METRICS_TRUSTED_PROXIES=127.0.0.1,::1

# ─── Address lookup ───
# OPTIONAL GETADDRESS_API_KEY=

# ─── Gunicorn tuning (web container) ───
# Override the gunicorn defaults baked into the Dockerfile CMD. Lowering
# GUNICORN_TIMEOUT keeps a single wedged request from starving the
# /health/live/ probe long enough for Docker to mark the container
# unhealthy and Traefik to drop it (surfaces to users as "no available
# server"). Raise it only if you have synchronous web paths that
# legitimately take longer; better, move those to Celery.
# DEFAULT GUNICORN_WORKERS=9
# DEFAULT GUNICORN_THREADS=10
# DEFAULT GUNICORN_TIMEOUT=120
# DEFAULT GUNICORN_GRACEFUL_TIMEOUT=30
# DEFAULT GUNICORN_MAX_REQUESTS=1000
# DEFAULT GUNICORN_MAX_REQUESTS_JITTER=100

# ─── Compose / Coolify orchestration ───
APP_DOMAIN=insyte.uk                                         # REQUIRED in prod compose (Traefik Host rule)
# DEFAULT BACKUP_INTERVAL_SECONDS=86400
# DEFAULT BACKUP_RETENTION_DAYS=7

# ─── Stripe E2E test-only (never in production) ───
# INSYTE_STRIPE_E2E_SECRET_KEY=sk_test_...
# INSYTE_STRIPE_E2E_PUBLISHABLE_KEY=pk_test_...
# INSYTE_STRIPE_E2E_PAYMENT_METHOD_ID=pm_card_visa
